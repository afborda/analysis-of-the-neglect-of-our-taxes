# Projeto Google Cloud para billing do BigQuery (conta gratuita basta)
GCP_PROJECT_ID=analise-municipios-br

# Caminho para o arquivo JSON de service account do Google Cloud
GOOGLE_APPLICATION_CREDENTIALS=./gcp-service-account.json

# Token da API do Portal da Transparência
# Obter em: https://api.portaldatransparencia.gov.br/swagger-ui
TRANSPARENCIA_API_TOKEN=seu-token-aqui
